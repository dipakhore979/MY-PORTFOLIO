# ---- Core ----
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_DAYS=7

# ---- CORS / cookies ----
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173
# lax | strict | none. Leave empty: "lax" in development, "none" in production
COOKIE_SAMESITE=
# Optional, e.g. .yourdomain.com when frontend and API share a parent domain
COOKIE_DOMAIN=

# ---- Public URL of this API (used to build local upload URLs). Optional ----
SERVER_URL=

# ---- Public URL of the website (used in sitemap.xml). Defaults to the first CLIENT_URL ----
SITE_URL=

# ---- Reverse proxies in front of the API (affects rate limiting by IP) ----
# 1 = Render/Railway only. 2 = site proxies /api to the API (Vercel/Netlify rewrite) + host.
TRUST_PROXY=1

# ---- Email notifications for the contact form (optional) ----
# Messages are always saved to MongoDB; email is only a notification.
# Receiver of the notifications:
CONTACT_RECEIVER=your-email@gmail.com

# Option A (recommended for hosting): Resend HTTPS API. Works on hosts that block SMTP
# (Render's free plan does). Create a key at resend.com.
RESEND_API_KEY=
# Without a verified domain use the default sender and send to your own account email.
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Option B: SMTP (fine locally). Leave SMTP_HOST empty to disable.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# For Gmail use an App Password (requires 2-step verification)
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# ---- Cloudinary (optional). If empty, images are stored in ./uploads ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- GitHub section (optional) ----
# By default the username is taken from the GitHub link in Admin > Profile.
GITHUB_USERNAME=
# Optional token (no scopes needed) raises GitHub's rate limit; the API caches results for an hour anyway.
GITHUB_TOKEN=

# ---- Resume (optional). If set, /api/resume redirects here ----
RESUME_URL=

# ---- Seed script (initial admin user) ----
ADMIN_NAME=Dipak Hore
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
