# ---------------------------------------------------------------
# Local development: the API runs on port 5000
# ---------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------
# Production (set these in Vercel / Netlify, not in a committed file)
#   VITE_API_URL=/api                      <- same-origin via the vercel.json / netlify.toml proxy
#   VITE_SITE_URL=https://your-domain.com  <- used for canonical URLs and share images
# ---------------------------------------------------------------
